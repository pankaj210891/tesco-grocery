{
  "name": "tesco-grocery",
  "version": "1.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "generate-images": "node scripts/generate-images.mjs",
    "fetch-images": "node scripts/fetch-product-images.mjs",
    "prepare": "husky",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:e2e": "cypress run --e2e --browser chrome",
    "cypress:run:component": "cypress run --component --browser chrome",
    "cypress:ci": "start-server-and-test start http://localhost:3000 cypress:run:e2e"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0",
    "*.{json,md}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "mongoose": "^9.6.1",
    "next": "16.2.5",
    "nodemailer": "^8.0.7",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/cypress": "^10.1.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^13.17.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "start-server-and-test": "^3.0.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
