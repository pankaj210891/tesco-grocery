# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. URL-encode special chars in the password
# (@ → %40, # → %23). Get it from: Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/prakash-supermarket?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=

# ── App (public — safe to expose to browser) ──────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Prakash Supermarket
